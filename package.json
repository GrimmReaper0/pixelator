{
  "name": "pixelator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first AI Phaser game creator with Anima Turbo and a Codex MCP plugin.",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "studio": "vite --host 127.0.0.1 --port 4173",
    "bridge": "tsx src/bridge/server.ts",
    "mcp": "tsx src/mcp/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "validate": "node scripts/validate-repo.mjs",
    "check": "npm run validate && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "phaser": "4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "tsx": "4.22.5",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
